set_io   sel_i[0] TOP_0_IN[0] 	#gfpga_pad_pinput_A2F[0]
set_io   sel_i[1] TOP_0_IN[1] 	#gfpga_pad_pinput_A2F[1]
set_io   d_dog_o LEFT_3_OUT[5] 	#gfpga_pad_poutput_F2A[119]
set_io   clk_i   TOP_0_IN[2] 	#gfpga_pad_pinput_A2F[2]
set_io   rst_ni  TOP_0_IN[3] 	#gfpga_pad_pinput_A2F[3]

# +++++++++++++++++++++++++++++++++++ watchdog +++++++++++++++++++++++++++++++++++
# EFPGA Port Management Stack Port
# 0b1       [0:0]     FPGA_RST_POL
# 0x6C      [1:8]     Clk0 delay chain
# 0xD8      [9:16]    Clk1 delay chain
# 0b0       [17:17]   Watchdog MODE_SEL_I
# 0b1       [18:18]   Watchdog WDT_EN_I
# 0xC8      [19:30]   LOGIC_L_V_I
# 0x0       [31:42]   LOGIC_H_V_I
# 0b1       [43:43]   CLK_DIV_EN_I
# 0x2       [44:55]   CLK_DIV_VALUE_I

# Always use the LEFT_0_IN[0] as the pad for AlkaiD devices
# Set the polarity of the reset. The mode can be LOW_ACTIVE or HIGH_ACTIVE
set_fabric_rst_pol -pad LEFT_0_IN[0] -mode LOW_ACTIVE

# Set the delay number for the two clock delay chains. Range from 0.00ns
#to 15.30ns. Minimum delay step is 0.06ns. Must include units and 2 digits
#in precision, e.g. 0.48ns
set_clk0_delay_chain -pad LEFT_0_IN[0] -delay 6.48ns
set_clk1_delay_chain -pad LEFT_0_IN[0] -delay 12.96ns

# Mode can be [COUNTER|PWM]. Status can be [ENABLE|DISABLE]
set_watchdog_operating_mode -pad LEFT_0_IN[0] -mode PWM -status ENABLE

set_watchdog_pwm -pad LEFT_0_IN[0] -low_value 100 -high_value 200


# The value ranges from [0, 4095]
set_watchdog_clock_divider -pad LEFT_0_IN[0] -status ENABLE -value 2
# ----------------------------------- watchdog -----------------------------------