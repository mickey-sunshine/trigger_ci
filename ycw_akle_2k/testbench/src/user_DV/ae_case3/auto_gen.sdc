create_clock -period 5 -waveform {0 2.5} clk_i

set_input_delay -clock clk_i -max 0 [get_ports {sig_off_i[0] sig_off_i[1] sig_off_i[2] sig_off_msk_i[0] sig_off_msk_i[1] sig_off_msk_i[2] sig_off_msk_i[3] sig_off_msk_i[4] sig_off_msk_i[5] sig_off_msk_i[6] sig_off_msk_i[7] sig_off_msk_i[8] sig_off_prot_mode_i[0] sig_off_prot_mode_i[1] sig_off_prot_mode_i[2] sig_off_trig_mode_i[0] sig_off_trig_mode_i[1] sig_off_trig_mode_i[2] sig_off_trig_pol_i[0] sig_off_trig_pol_i[1] sig_off_trig_pol_i[2] sig_off_trig_pol_i[3] sig_off_trig_pol_i[4] sig_off_trig_pol_i[5] sig_ctrl_loop_start_i sig_i[0] sig_i[1] sig_i[2] sig_i[3] sig_i[4] sig_i[5] sig_i[6] sig_i[7] sig_i[8] sig_i[9] sig_i[10] sig_i[11] sig_i[12] sig_i[13] sig_i[14] sig_i[15] sig_i[16] sig_i[17]}]
set_input_delay -clock clk_i -min 0 [get_ports {sig_off_i[0] sig_off_i[1] sig_off_i[2] sig_off_msk_i[0] sig_off_msk_i[1] sig_off_msk_i[2] sig_off_msk_i[3] sig_off_msk_i[4] sig_off_msk_i[5] sig_off_msk_i[6] sig_off_msk_i[7] sig_off_msk_i[8] sig_off_prot_mode_i[0] sig_off_prot_mode_i[1] sig_off_prot_mode_i[2] sig_off_trig_mode_i[0] sig_off_trig_mode_i[1] sig_off_trig_mode_i[2] sig_off_trig_pol_i[0] sig_off_trig_pol_i[1] sig_off_trig_pol_i[2] sig_off_trig_pol_i[3] sig_off_trig_pol_i[4] sig_off_trig_pol_i[5] sig_ctrl_loop_start_i sig_i[0] sig_i[1] sig_i[2] sig_i[3] sig_i[4] sig_i[5] sig_i[6] sig_i[7] sig_i[8] sig_i[9] sig_i[10] sig_i[11] sig_i[12] sig_i[13] sig_i[14] sig_i[15] sig_i[16] sig_i[17]}]

set_output_delay -clock clk_i -max 0 [get_ports {sig_o[0] sig_o[1] sig_o[2] sig_o[3] sig_o[4] sig_o[5] sig_o[6] sig_o[7] sig_o[8] sig_o[9] sig_o[10] sig_o[11] sig_o[12] sig_o[13] sig_o[14] sig_o[15] sig_o[16] sig_o[17]}]
